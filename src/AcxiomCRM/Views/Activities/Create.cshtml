@model AcxiomCRM.ViewModels.ActivityFormViewModel
@using AcxiomCRM.Services
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Log Activity";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-telephone-plus text-primary me-2"></i> Log Activity</h2>
        <p class="text-muted mb-0">Record interaction summary, discussion notes, or tasks</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Activities
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="ActivityType" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="ActivityType" class="form-select">
                                <option value="Call">Call</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Email">Email</option>
                                <option value="Task">Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ActivityDate" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="ActivityDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="Status" class="form-select">
                                <option value="Completed">Completed</option>
                                <option value="Scheduled">Scheduled</option>
                                <option value="Cancelled">Cancelled</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Subject" class="form-control" placeholder="e.g. Discussed proposal with technical buyer" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" asp-items="@Model.CustomersList" class="form-select">
                                <option value="">-- Associate Customer --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label fw-semibold"></label>
                            <select asp-for="LeadId" asp-items="@Model.LeadsList" class="form-select">
                                <option value="">-- Associate Lead --</option>
                            </select>
                        </div>
                        @if (!CurrentUser.IsSalesExecutive && Model.OwnersList != null)
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                                <select asp-for="AssignedTo" asp-items="@Model.OwnersList" class="form-select">
                                    <option value="">-- Staff Member --</option>
                                </select>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed notes, discussion topics, outcomes, action items..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Log Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
