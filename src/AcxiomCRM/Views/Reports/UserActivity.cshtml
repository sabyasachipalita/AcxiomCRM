@model List<AcxiomCRM.ViewModels.UserActivityReportItem>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-lines-fill text-info me-2"></i> Staff Activity & Workload</h2>
        <p class="text-muted mb-0">Manager / Admin inspection of CRM operational volumes per user</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Reports
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Staff Name</th>
                        <th>Role</th>
                        <th>Customers Managed</th>
                        <th>Leads Assigned</th>
                        <th>Opportunities Managed</th>
                        <th>Follow-Ups Logged</th>
                        <th class="pe-3">Activities Logged</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-dark">@u.UserName</td>
                            <td>
                                <span class="badge @(u.Role == "Admin" ? "bg-danger" : u.Role == "Manager" ? "bg-warning text-dark" : "bg-primary")">
                                    @u.Role
                                </span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@u.CustomersManaged</span></td>
                            <td><span class="badge bg-light text-dark border">@u.LeadsAssigned</span></td>
                            <td><span class="badge bg-light text-dark border">@u.OpportunitiesManaged</span></td>
                            <td><span class="badge bg-light text-dark border">@u.FollowUpsLogged</span></td>
                            <td class="pe-3"><span class="badge bg-light text-dark border">@u.ActivitiesLogged</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
