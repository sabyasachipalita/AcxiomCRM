@model AcxiomCRM.ViewModels.ConversionReportViewModel
@{
    ViewData["Title"] = "Conversion & Win Rate Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-funnel-fill text-success me-2"></i> Sales Conversion & Win Rate</h2>
        <p class="text-muted mb-0">Efficiency metrics measuring lead conversion efficacy and deal closure win rates</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Reports
    </a>
</div>

<div class="row g-4 mb-4">
    <!-- Lead Conversion Metric Card -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-start border-info border-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="text-uppercase text-muted small fw-bold">Lead Conversion Rate</div>
                        <div class="display-4 fw-bold text-info mt-1">@Model.LeadConversionRate%</div>
                    </div>
                    <div class="bg-info bg-opacity-10 text-info p-3 rounded-circle">
                        <i class="bi bi-funnel fs-2"></i>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 12px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: @Model.LeadConversionRate%"></div>
                </div>

                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span>Total Inbound Leads:</span>
                        <span class="fw-bold">@Model.TotalLeads</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span>Successfully Converted to Customer:</span>
                        <span class="fw-bold text-success">@Model.ConvertedLeads</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Opportunity Win Rate Card -->
    <div class="col-md-6">
        <div class="card h-100 shadow-sm border-start border-success border-4">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <div class="text-uppercase text-muted small fw-bold">Deal Win Rate</div>
                        <div class="display-4 fw-bold text-success mt-1">@Model.WinRate%</div>
                    </div>
                    <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle">
                        <i class="bi bi-trophy-fill fs-2"></i>
                    </div>
                </div>

                <div class="progress mb-3" style="height: 12px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @Model.WinRate%"></div>
                </div>

                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span>Total Closed Opportunities:</span>
                        <span class="fw-bold">@Model.TotalClosedOpportunities</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span>Deals Won:</span>
                        <span class="fw-bold text-success">@Model.WonOpportunities</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span>Deals Lost:</span>
                        <span class="fw-bold text-danger">@Model.LostOpportunities</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
