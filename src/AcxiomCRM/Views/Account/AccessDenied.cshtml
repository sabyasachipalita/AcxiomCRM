@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <div class="text-danger mb-3">
                    <i class="bi bi-shield-slash-fill" style="font-size: 4rem;"></i>
                </div>
                <h2 class="fw-bold mb-2">Access Denied</h2>
                <p class="text-muted mb-4">
                    You do not have sufficient role permissions or data ownership rights to access this resource.
                </p>
                <div>
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
