@model AcxiomCRM.ViewModels.LeadDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Lead.LeadName} - Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">@Model.Lead.LeadName</h2>
            <span class="badge bg-light text-dark border">@Model.Lead.LeadCode</span>
            <span class="badge @(Model.Lead.Status == "Qualified" ? "bg-success" : Model.Lead.Status == "Converted" ? "bg-primary" : Model.Lead.Status == "Lost" ? "bg-danger" : "bg-warning text-dark")">
                @Model.Lead.Status
            </span>
        </div>
        <p class="text-muted mb-0">Captured on @Model.Lead.CreatedDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Lead.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.Lead.LeadId" class="btn btn-success">
                <i class="bi bi-arrow-repeat me-1"></i> Convert Lead
            </a>
        }
        else if (Model.Lead.ConvertedCustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Lead.ConvertedCustomerId.Value" class="btn btn-outline-success">
                <i class="bi bi-person-check me-1"></i> View Converted Customer
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.Lead.LeadId" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Leads
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Lead Overview Card -->
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">Lead Information</div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Company:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Lead.CompanyName) ? "—" : Model.Lead.CompanyName)</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Email:</span>
                        <span class="fw-semibold"><a href="mailto:@Model.Lead.Email" class="text-decoration-none">@Model.Lead.Email</a></span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Phone:</span>
                        <span class="fw-semibold"><a href="tel:@Model.Lead.Phone" class="text-decoration-none">@Model.Lead.Phone</a></span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Source:</span>
                        <span class="badge bg-light text-dark">@Model.Lead.Source</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Priority:</span>
                        <span class="badge @(Model.Lead.Priority == "Urgent" ? "bg-danger" : "bg-secondary")">@Model.Lead.Priority</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Expected Value:</span>
                        <span class="fw-bold text-success">$@Model.Lead.ExpectedValue.ToString("N0")</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Assigned Owner:</span>
                        <span class="badge bg-primary">@(Model.Lead.Owner?.FullName ?? "Unassigned")</span>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.Lead.Notes))
                    {
                        <li class="list-group-item px-0">
                            <span class="text-muted d-block mb-1">Notes:</span>
                            <span class="small fst-italic">@Model.Lead.Notes</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Quick Action Shortcuts -->
        <div class="card shadow-sm">
            <div class="card-header fw-bold">Lead Activities</div>
            <div class="card-body d-grid gap-2">
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-outline-warning text-dark btn-sm text-start">
                    <i class="bi bi-calendar-plus me-2"></i> Schedule Follow-Up
                </a>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.Lead.LeadId" class="btn btn-outline-info text-dark btn-sm text-start">
                    <i class="bi bi-telephone-plus me-2"></i> Log Call / Meeting
                </a>
            </div>
        </div>
    </div>

    <!-- Right Side Tabs: Follow-Ups and Activities -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header p-0 border-bottom">
                <ul class="nav nav-tabs card-header-tabs m-0 px-3" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active py-3" data-bs-toggle="tab" data-bs-target="#tab-followups" type="button">
                            <i class="bi bi-calendar-check me-1"></i> Follow-Ups (@Model.FollowUps.Count)
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-3" data-bs-toggle="tab" data-bs-target="#tab-activities" type="button">
                            <i class="bi bi-clock-history me-1"></i> Activities (@Model.Activities.Count)
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body tab-content p-4">
                <!-- Tab 1: FollowUps -->
                <div class="tab-pane fade show active" id="tab-followups">
                    @if (Model.FollowUps.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var f in Model.FollowUps)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <div class="fw-bold">@f.Subject</div>
                                        <div class="small text-muted">
                                            <i class="bi bi-calendar me-1"></i> @f.FollowUpDate.ToString("MMM dd, yyyy HH:mm") |
                                            <span class="badge bg-secondary">@f.FollowUpType</span>
                                            @if (!string.IsNullOrEmpty(f.Remarks))
                                            {
                                                <span class="ms-2 fst-italic">"@f.Remarks"</span>
                                            }
                                        </div>
                                    </div>
                                    <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-primary" : "bg-danger")">
                                        @f.Status
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0">No follow-ups recorded yet for this lead.</p>
                    }
                </div>

                <!-- Tab 2: Activities -->
                <div class="tab-pane fade" id="tab-activities">
                    @if (Model.Activities.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var a in Model.Activities)
                            {
                                <li class="list-group-item py-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="fw-bold">
                                            <span class="badge bg-dark me-2">@a.ActivityType</span> @a.Subject
                                        </div>
                                        <small class="text-muted">@a.ActivityDate.ToString("MMM dd, yyyy HH:mm")</small>
                                    </div>
                                    @if (!string.IsNullOrEmpty(a.Description))
                                    {
                                        <p class="small text-muted mb-0">@a.Description</p>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted text-center py-4 mb-0">No activities recorded yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
