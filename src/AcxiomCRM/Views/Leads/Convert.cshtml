@model AcxiomCRM.ViewModels.LeadConvertViewModel
@using AcxiomCRM.Services
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-arrow-repeat text-success me-2"></i> Lead-to-Customer Conversion</h2>
        <p class="text-muted mb-0">Transform qualified lead <strong>@Model.LeadName</strong> into Customer and active Opportunity</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Cancel
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-top border-success border-4">
            <div class="card-body p-4">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="CompanyName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <!-- Step 1: Customer Profile Confirmation -->
                    <div class="bg-light p-3 rounded mb-4 border">
                        <div class="fw-bold text-dark mb-2"><i class="bi bi-person-check-fill text-success me-2"></i> 1. Customer Account Creation</div>
                        <div class="row g-2 small">
                            <div class="col-md-4"><strong>Customer Name:</strong> @Model.LeadName</div>
                            <div class="col-md-4"><strong>Email:</strong> @Model.Email</div>
                            <div class="col-md-4"><strong>Phone:</strong> @Model.Phone</div>
                            <div class="col-md-6"><strong>Company:</strong> @(string.IsNullOrEmpty(Model.CompanyName) ? "Individual" : Model.CompanyName)</div>
                            <div class="col-md-6"><em>Customer record will be auto-generated and unique CustomerCode assigned.</em></div>
                        </div>
                    </div>

                    <!-- Step 2: Opportunity Options -->
                    <div class="mb-4">
                        <div class="form-check form-switch mb-3">
                            <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" id="chkCreateOpp" checked />
                            <label class="form-check-label fw-bold text-dark" for="chkCreateOpp">
                                2. Also Create Sales Opportunity (Recommended)
                            </label>
                        </div>

                        <div id="oppFieldsContainer" class="p-3 border rounded bg-white shadow-sm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="OpportunityName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                    <input asp-for="OpportunityName" class="form-control" />
                                    <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="OpportunityAmount" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="OpportunityAmount" type="number" step="100" class="form-control" />
                                    </div>
                                    <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="OpportunityStage" class="form-label fw-semibold">Stage</label>
                                    <select asp-for="OpportunityStage" class="form-select">
                                        <option value="Qualification">Qualification</option>
                                        <option value="Proposal">Proposal</option>
                                        <option value="Negotiation">Negotiation</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="Probability" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <span asp-validation-for="Probability" class="text-danger small"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                                    <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                                    <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!CurrentUser.IsSalesExecutive && Model.OwnersList != null)
                    {
                        <div class="mb-4">
                            <label asp-for="AssignedTo" class="form-label fw-semibold">Assign Customer & Opportunity Owner</label>
                            <select asp-for="AssignedTo" asp-items="@Model.OwnersList" class="form-select">
                                <option value="">-- Keep Lead's Original Assignee --</option>
                            </select>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Finalize Conversion
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('chkCreateOpp').addEventListener('change', function() {
            document.getElementById('oppFieldsContainer').style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
