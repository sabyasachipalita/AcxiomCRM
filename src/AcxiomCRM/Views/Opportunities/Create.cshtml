@model AcxiomCRM.ViewModels.OpportunityFormViewModel
@using AcxiomCRM.Services
@inject ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Create Opportunity";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-graph-up text-success me-2"></i> Create Opportunity</h2>
        <p class="text-muted mb-0">Record a new sales opportunity with value, stage, and close timeline</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Opportunities
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Deal Details</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="OpportunityName" class="form-control" placeholder="e.g. Cloud Security Migration" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" asp-items="@Model.CustomersList" class="form-select">
                                <option value="">-- Select Customer Account --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="10000" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group">
                                <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Pipeline Status & Timelines</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="Status" class="form-select">
                                <option value="Open">Open</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                        </div>
                        @if (!CurrentUser.IsSalesExecutive && Model.OwnersList != null)
                        {
                            <div class="col-md-6">
                                <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                                <select asp-for="AssignedTo" asp-items="@Model.OwnersList" class="form-select">
                                    <option value="">-- Assign Sales Executive --</option>
                                </select>
                                <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Deal scope, milestones, competitor info..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Save Opportunity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
