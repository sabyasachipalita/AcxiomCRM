@model AcxiomCRM.ViewModels.OpportunityDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Opportunity.OpportunityName} - Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">@Model.Opportunity.OpportunityName</h2>
            <span class="badge bg-light text-dark border">@Model.Opportunity.Stage</span>
            <span class="badge @(Model.Opportunity.Status == "Won" ? "bg-success" : Model.Opportunity.Status == "Lost" ? "bg-danger" : "bg-primary")">
                @Model.Opportunity.Status
            </span>
        </div>
        <p class="text-muted mb-0">Created on @Model.Opportunity.CreatedDate.ToString("MMMM dd, yyyy")</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.OpportunityId" class="btn btn-warning text-dark">
            <i class="bi bi-calendar-plus me-1"></i> Add Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Opportunity.OpportunityId" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Opportunities
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Financial Metrics & Deal Specs -->
    <div class="col-lg-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header fw-bold">Deal Financials & Pipeline Data</div>
            <div class="card-body">
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <div class="p-3 bg-light rounded text-center">
                            <small class="text-muted text-uppercase fw-bold">Face Value</small>
                            <div class="fs-4 fw-bold text-success mt-1">$@Model.Opportunity.Amount.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-light rounded text-center">
                            <small class="text-muted text-uppercase fw-bold">Weighted Value</small>
                            <div class="fs-4 fw-bold text-primary mt-1">$@Model.Opportunity.WeightedAmount.ToString("N0")</div>
                        </div>
                    </div>
                </div>

                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Probability:</span>
                        <span class="fw-bold">@Model.Opportunity.Probability%</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Target Close Date:</span>
                        <span class="fw-semibold">@Model.Opportunity.ExpectedCloseDate.ToString("MMMM dd, yyyy")</span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Customer Account:</span>
                        <span class="fw-semibold">
                            @if (Model.Opportunity.Customer != null)
                            {
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Opportunity.CustomerId">
                                    @Model.Opportunity.Customer.CustomerName
                                </a>
                            }
                            else
                            {
                                <span>None</span>
                            }
                        </span>
                    </li>
                    <li class="list-group-item px-0 d-flex justify-content-between">
                        <span class="text-muted">Assigned Owner:</span>
                        <span class="badge bg-primary">@(Model.Opportunity.Owner?.FullName ?? "Unassigned")</span>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.Opportunity.Notes))
                    {
                        <li class="list-group-item px-0">
                            <span class="text-muted d-block mb-1">Deal Notes:</span>
                            <span class="small fst-italic">@Model.Opportunity.Notes</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Related Follow-Ups -->
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Deal Follow-Ups & Milestones</span>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Opportunity.OpportunityId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus"></i> Schedule
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var f in Model.FollowUps)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div>
                                    <div class="fw-bold">@f.Subject</div>
                                    <small class="text-muted">
                                        @f.FollowUpDate.ToString("MMM dd, yyyy HH:mm") | Type: @f.FollowUpType
                                        @if (!string.IsNullOrEmpty(f.Remarks))
                                        {
                                            <span> - "@f.Remarks"</span>
                                        }
                                    </small>
                                </div>
                                <span class="badge @(f.Status == "Completed" ? "bg-success" : f.Status == "Planned" ? "bg-primary" : "bg-danger")">
                                    @f.Status
                                </span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="p-4 text-center text-muted">No follow-ups recorded for this deal.</div>
                }
            </div>
        </div>
    </div>
</div>
